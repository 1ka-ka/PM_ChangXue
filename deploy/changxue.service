# Uvicorn 服务单元（S12 部署：systemd 托管，2 worker）
# 安装位置：/etc/systemd/system/changxue.service
[Unit]
Description=ChangXue Community API (FastAPI/Uvicorn)
After=network.target mysql.service

[Service]
WorkingDirectory=/opt/changxue/backend
ExecStart=/opt/changxue/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3
User=www-data
Group=www-data
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
